# LLM 提供商：zhipu 或 qwen
XUANPING_LLM_PROVIDER=zhipu
# 智谱或阿里云 DashScope API Key（按所选 provider 填写）
XUANPING_LLM_API_KEY=
# 留空时使用 provider 对应的默认模型
XUANPING_LLM_MODEL=
# OpenAI 兼容接口地址；留空时按 provider 自动选择
XUANPING_LLM_BASE_URL=
# Amazon 站点域名，例如 www.amazon.com、www.amazon.co.jp
XUANPING_AMAZON_DOMAIN=www.amazon.com
# 榜单抓取默认请求间隔下限（秒）
XUANPING_REQUEST_DELAY_MIN=2
# 榜单抓取默认请求间隔上限（秒）
XUANPING_REQUEST_DELAY_MAX=5
# 可选代理池，逗号分隔，例如 http://proxy1:8080,http://proxy2:8080
XUANPING_PROXIES=
# 代理轮换策略：random 或 round_robin
XUANPING_PROXY_STRATEGY=random
# 连续失败次数达到阈值后暂时剔除代理
XUANPING_PROXY_MAX_FAILURES=3
# 代理冷却秒数，期满后重新尝试
XUANPING_PROXY_COOLDOWN=300
# 是否启动时检查代理可用性（会发出轻量请求）
XUANPING_PROXY_HEALTH_CHECK=false
# SQLite 数据库文件路径
XUANPING_DATABASE_PATH=xuanping.db
# 每个候选商品抓取的低星评论数量上限
XUANPING_REVIEW_LIMIT=30
# 利润估算的默认采购成本占售价比例
XUANPING_DEFAULT_COST_MULTIPLIER=0.3
# 是否启用 1688 供应链比价（需要配置 LLM API Key）
XUANPING_ENABLE_1688=true
# 人民币兑美元换算汇率；需定期更新
XUANPING_CNY_USD_RATE=7.2
# 每个商品在 1688 搜索并解析的候选数
XUANPING_1688_CANDIDATES=10
# 1688 搜索关键词编码：utf-8 或 gbk（按所用页面接口选择）
XUANPING_1688_KEYWORD_ENCODING=utf-8
# 1688 搜索 URL 模板；{keywords} 会被替换为编码后的关键词
XUANPING_1688_SEARCH_URL=https://s.1688.com/selloffer/offer_search.htm?keywords={keywords}
# 仅对评分 Top N 商品验证 Google Trends
XUANPING_TRENDS_TOP_N=20
# 五维评分权重（JSON；可自行调整，但至少一个权重大于 0）
XUANPING_SCORE_WEIGHTS={"demand":0.30,"competition":0.20,"profit":0.25,"opportunity":0.15,"risk":0.10}
